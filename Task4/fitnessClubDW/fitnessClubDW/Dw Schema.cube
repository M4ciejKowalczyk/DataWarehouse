  <Source dwd:design-time-name="1e56ca82-a126-48a5-984e-fa67796029a0">
    <DataSourceViewID>Dw Schema</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="40dfe8dd-37cf-4f80-a159-ae8b0173482b">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].SredniaOcenaUczestnictwa
 AS IIF(
        [Measures].[Liczba Ocen] = 0,
        NULL,
        [Measures].[Ocena] / [Measures].[Liczba Ocen]
    ), 
VISIBLE = 1  ;   
CREATE MEMBER CURRENTCUBE.[Measures].SredniaLiczbaZapisanych
 AS IIF(
        [Measures].[LiczbaZajec] = 0,
        NULL,
        [Measures].[SumaZapisanych] / [Measures].[LiczbaZajec]
    ), 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].SredniaFrekwencja
 AS IIF(
        [Measures].[LiczbaZajec] = 0,
        NULL,
        [Measures].[SumaFrekwencji] / [Measures].[LiczbaZajec]
    ), 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].GlobalnaFrekwencja
 AS IIF(
        [Measures].[SumaZapisanych] = 0,
        NULL,
        ([Measures].[LiczbaObecnych] / [Measures].[SumaZapisanych]) * 100
    ), 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].SredniaOcenZajec
 AS IIF(
        [Measures].[LiczbaSrednichOcenZajec] = 0,
        NULL,
        [Measures].[SumaSrednichOcenZajec] / [Measures].[LiczbaSrednichOcenZajec]
    ), 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].SredniProcentZapelnienia
 AS IIF(
        [Measures].[LiczbaZajec] = 0,
        NULL,
        [Measures].[SumaProcentowZapelnienia] / [Measures].[LiczbaZajec]
    ), 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>